{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "M55M1: Attach (WCH-Link)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "pyocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build-debug/M55M1_GestureAI.axf",
            "device": "m55m1r2ljae",
            "serverpath": "C:/Users/proha/AppData/Local/Programs/Python/Python310/Scripts/pyocd.exe",
            "gdbPath": "C:/ST/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverArgs": [
                "--probe",
                "0001A0000001",
                "--target",
                "m55m1r2ljae",
                "--connect",
                "attach",
                "-f",
                "100000",
                "--script",
                "${workspaceFolder}/tools/pyocd/m55m1r2ljae.py"
            ],
            "postStartSessionCommands": [
                "monitor reset halt sysresetreq",
                "tbreak main",
                "continue"
            ],
            "showDevDebugOutput": "raw"
        },
        {
            "name": "M55M1: Launch (WCH-Link, verified)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "pyocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build-debug/M55M1_GestureAI.axf",
            "device": "m55m1r2ljae",
            "serverpath": "C:/Users/proha/AppData/Local/Programs/Python/Python310/Scripts/pyocd.exe",
            "gdbPath": "C:/ST/STM32CubeCLT_1.20.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverArgs": [
                "--probe",
                "0001A0000001",
                "--target",
                "m55m1r2ljae",
                "--connect",
                "attach",
                "-f",
                "100000",
                "--script",
                "${workspaceFolder}/tools/pyocd/m55m1r2ljae.py"
            ],
            "preLaunchTask": "M55M1: Require Flash verification",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "CMSIS_DAP@pyOCD (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/libs\\CMSIS\\DSP\\Examples\\cmsis_build",
            "program": "bayes/VHT-Corstone-310/Release/bayes.axf",
            "gdb": "arm-none-eabi-gdb",
            "preLaunchTask": "CMSIS Load",
            "initCommands": [
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "gdbserver",
                    "--port",
                    "3333",
                    "--probe",
                    "cmsisdap:",
                    "--connect",
                    "attach",
                    "--cbuild-run",
                    "${command:cmsis-csolution.getCbuildRunFile}"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "CMSIS_DAP@pyOCD (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/libs\\CMSIS\\DSP\\Examples\\cmsis_build",
            "program": "bayes/VHT-Corstone-310/Release/bayes.axf",
            "gdb": "arm-none-eabi-gdb",
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "updateConfiguration": "auto"
            }
        }
    ]
}