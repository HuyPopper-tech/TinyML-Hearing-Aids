      "rtk",
      "proxy",
      "cmd.exe",
      "/d",
      "/c",
      "build.bat release config"
    ],
    "exit_code": 0,
    "log": "Configure_Release.log"
  },
  {
    "name": "Configure_Release_Probe",
    "command": [
      "rtk",
      "proxy",
      "cmake",
      "-S",
