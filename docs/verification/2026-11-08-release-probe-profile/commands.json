      "-B",
      "D:/TinyML-Hearing-Aids/build",
      "-DM55M1_AUDIO_RELEASE_PROBE=ON"
    ],
    "exit_code": 0,
    "log": "Configure_Release_Probe.log"
  },
  {
    "name": "Build_Release_Probe",
