{
  "version": 3,
  "configurePresets": [
    {
      "name": "m55m1-release",
      "displayName": "M55M1 Release (Arm Compiler 6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/armclang.cmake",
        "M55M1_MODEL_PACKAGE_DIR": "",
        "M55M1_ENABLE_TFLM": "OFF"
      }
    },
    {
      "name": "m55m1-debug",
      "displayName": "M55M1 Debug (Arm Compiler 6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/armclang.cmake",
        "M55M1_MODEL_PACKAGE_DIR": "",
        "M55M1_ENABLE_TFLM": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "m55m1-release",
      "configurePreset": "m55m1-release"
    },
    {
      "name": "m55m1-debug",
      "configurePreset": "m55m1-debug"
    }
  ]
}
