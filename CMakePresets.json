{
  "version": 3,
  "configurePresets": [
    {
      "name": "m55m1-release",
      "displayName": "Custom PCB M55M1 Release (Arm Compiler 6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/armclang.cmake",
        "M55M1_MODEL_PACKAGE_DIR": "${sourceDir}/models/deepfir",
        "M55M1_ENABLE_TFLM": "ON",
        "M55M1_ENABLE_DSP": "ON",
        "M55M1_ENABLE_NN": "ON",
        "M55M1_ENABLE_ETHOSU_RUNTIME": "ON",
        "M55M1_ENABLE_DAC_I2S_OUTPUT": "ON",
        "M55M1_ENABLE_DCACHE": "ON",
        "M55M1_DEEPFIR_MVE": "ON",
        "M55M1_MODEL_IN_SRAM": "ON",
        "M55M1_DEBUG_UART_IDX": "2",
        "M55M1_DEEPFIR_COMPILED_REPLAY": "OFF",
        "M55M1_AUDIO_UART_PCM_CAPTURE": "OFF",
        "M55M1_AUDIO_RELEASE_PROBE": "OFF"
      }
    },
    {
      "name": "m55m1-debug",
      "displayName": "Custom PCB M55M1 Debug (Arm Compiler 6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/armclang.cmake",
        "M55M1_MODEL_PACKAGE_DIR": "${sourceDir}/models/deepfir",
        "M55M1_ENABLE_TFLM": "ON",
        "M55M1_ENABLE_DSP": "ON",
        "M55M1_ENABLE_NN": "ON",
        "M55M1_ENABLE_ETHOSU_RUNTIME": "ON",
        "M55M1_ENABLE_DAC_I2S_OUTPUT": "ON",
        "M55M1_ENABLE_DCACHE": "ON",
        "M55M1_DEEPFIR_MVE": "ON",
        "M55M1_MODEL_IN_SRAM": "ON",
        "M55M1_DEBUG_UART_IDX": "2",
        "M55M1_DEEPFIR_COMPILED_REPLAY": "OFF",
        "M55M1_AUDIO_UART_PCM_CAPTURE": "OFF",
        "M55M1_AUDIO_RELEASE_PROBE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "m55m1-release",
      "configurePreset": "m55m1-release"
    },
    {
      "name": "m55m1-debug",
      "configurePreset": "m55m1-debug"
    }
  ]
}
