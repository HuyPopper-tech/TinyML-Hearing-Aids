# .clangd - configuration for clangd (the language server behind VS Code's
# "C/C++ (clangd)" extension, used for Ctrl+click go-to-definition, hover,
# completion, diagnostics).
#
# The compilation database is generated by CMake into build/compile_commands.json
# (CMAKE_EXPORT_COMPILE_COMMANDS=ON in CMakeLists.txt) and symlinked to the
# project root as ./compile_commands.json. Either location is found by clangd.

CompileFlags:
  # Point clangd at the CMake-generated database (relative to this .clangd file).
  CompilationDatabase: build

  # armclang (Arm Compiler 6) is clang-based, so clangd understands almost all
  # of its flags (--target=, -mcpu=, -mfloat-abi=, -I, -D, ...). Strip the few
  # that are armclang-only and would make vanilla clangd emit noise, so the
  # language server parses headers cleanly and indexing stays fast.
  Remove:
    - -flax-vector-conversions=integer   # armclang spelling; clangd infers MVE types from -mcpu
    - -fshort-enums
    - -fshort-wchar

Diagnostics:
  # Suppress the f16 infinity note that armclang emits in arm_vec_math_f16.h;
  # it is benign (Helium f16 uses INFINITY) and floods the Problems pane.
  Suppress:
    - nan_infinity_disabled
  # Trust the toolchain defines; do not re-flag unused microlib paths.
  UnusedIncludes: Strict

Index:
  Background: Build
